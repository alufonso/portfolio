---
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/700.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import '../styles/print.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// Crawlers need absolute URLs: only emit og:image/og:url when `site` is configured (astro.config.mjs).
const site = Astro.site;
const ogImage = site && new URL('/og.png', site).href;
const ogUrl = site && new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Pixel art of a cosy room at night with rain on the window, a coder at the monitor and a sleeping cat, captioned Agustar Alfonso, Full-stack & AI Engineer" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
