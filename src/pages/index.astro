---
import { existsSync } from 'node:fs';
import Layout from '../components/Layout.astro';
import Deck from '../components/Deck.astro';
import Player from '../components/islands/Player';
import PixelScene from '../components/islands/PixelScene';
import { profile } from '../data/profile';

const b = profile.basic_info;
// shortcut: this path is cwd-relative (fine for npm scripts and Vercel, wrong if built from another dir); use astro publicDir if that matters.
const hasPdf = existsSync('public/cv.pdf');
const cv = hasPdf ? '/cv.pdf' : '/cv';
const tabs = [
  { id: 'now-playing', twin: 'Now Playing', plain: 'About' },
  { id: 'playlist', twin: 'Playlist', plain: 'Experience' },
  { id: 'singles', twin: 'Singles', plain: 'Projects' },
  { id: 'liner-notes', twin: 'Liner Notes', plain: 'Education & Publication' },
  { id: 'stickers', twin: 'Stickers', plain: 'Certificates' },
] as const;
// Labels only: no contact data reaches the island.
const itemLabels = {
  'now-playing': ['About'],
  playlist: profile.work_experience.map((w) => `${w.title} — ${w.company}`),
  singles: profile.projects.map((p) => p.name),
  'liner-notes': [
    ...profile.education.map((e) => e.degree),
    ...profile.publications.map((p) => p.title),
    ...profile.org_experience.map((o) => o.role),
  ],
  stickers: profile.certificates.map((c) => c.name),
};
const linkedin = /^[a-z]+:\/\//i.test(b.linkedin) ? b.linkedin : `https://${b.linkedin}`;
---

<Layout
  title="Agustar Alfonso — Full-stack & AI Engineer"
  description="Portfolio of Agustar Alfonso, full-stack and AI engineer."
>
  <noscript><style>.player .tabs, .player .transport { display: none; }</style></noscript>
  <main class="shell">
    <div class="left">
      <h1>{b.name}</h1>
      <PixelScene client:load covers={profile.projects.map((p) => p.cover)} />
      <Player client:load tabs={[...tabs]} itemLabels={itemLabels} />
      <nav aria-label="Actions">
        <a href={cv} download={hasPdf ? true : undefined}>⬇ CV</a>
        <a href="/cv">≡ Plain CV</a>
        <a href={`mailto:${b.email}`}>✉ Contact</a>
        <a href={linkedin}>LinkedIn</a>
      </nav>
    </div>
    <Deck />
  </main>
</Layout>

<style>
  .shell {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem;
    padding: 1rem 1rem 0; max-width: 72rem; margin: 0 auto;
  }
  .shell > * { min-width: 0; }
  h1 { font-family: var(--font-pixel); font-size: clamp(1.5rem, 5vw, 2.1rem); margin: 0; overflow-wrap: anywhere; }
  .left { display: grid; gap: 1.1rem; align-content: start; }
  .left :global(.scene) { margin: 0; }
  .left :global(.scene svg) { border: 2px solid var(--ink); box-sizing: border-box; }

  nav { display: flex; flex-wrap: wrap; gap: .6rem; }
  nav a {
    display: flex; align-items: center; justify-content: center;
    font: 600 .9rem/1.2 var(--font-sans); color: var(--ink); text-decoration: none; text-align: center;
    background: var(--paper); border: 2px solid var(--ink); padding: .45rem .75rem;
  }
  nav a:hover { background: #fff; }
  nav a:first-child { background: var(--accent-ink); color: var(--paper); box-shadow: 3px 3px 0 var(--ink); }

  @media (max-width: 899.98px) {
    /* Children join the shell grid so the action bar can stick across the whole page. */
    .left { display: contents; }
    .left :global(.scene svg) { max-height: 7.5rem; }
    nav {
      order: 1; position: sticky; bottom: 0; z-index: 1; margin: 0 -1rem;
      flex-wrap: nowrap; gap: .4rem; padding: .5rem 1rem; background: var(--paper);
      border-top: 2px solid var(--ink);
    }
    nav a { flex: 1 1 0; min-width: 0; font-size: .8rem; padding: .45rem .2rem; overflow-wrap: anywhere; }
    nav a:first-child { box-shadow: none; }
  }
  @media (min-width: 900px) {
    .shell { grid-template-columns: 42% minmax(0, 1fr); gap: 2.5rem; padding: 2rem 1.5rem 3rem; }
  }
  @media (min-width: 900px) and (min-height: 720px) {
    .left { position: sticky; top: 1.5rem; align-self: start; }
  }
</style>
