---
import Layout from '../components/Layout.astro';
---

<Layout title="Track not found — Agustar Alfonso" description="This track does not exist.">
  <main class="nf">
    <h1>Track not found</h1>
    <p>This page skipped off the playlist. Let's get back to the music.</p>
    <p><a href="/">◀ Back to the player</a></p>
  </main>
</Layout>

<style is:global>
  .nf { max-width: 36rem; margin: 4rem auto; padding: 0 16px; font-family: var(--font-serif); text-align: center; }
  .nf h1 { font-family: var(--font-pixel); }
  .nf a { color: var(--accent-ink); }
</style>
