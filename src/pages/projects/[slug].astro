---
import Layout from '../../components/Layout.astro';
import { Cover } from '../../art/covers';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return profile.projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const c = p.case_study;
---

<Layout title={`${p.name} — Agustar Alfonso`} description={c.summary}>
  <main class="cs">
    <header class="player">
      <Cover id={p.cover} size={128} />
      <div>
        <a href="/#singles">◀ Back to Singles</a>
        <h1>{p.name}</h1>
        <p class="role">{c.role}</p>
      </div>
    </header>

    <p class="summary">{c.summary}</p>

    <section><h2>Problem</h2><p>{c.problem}</p></section>
    <section>
      <h2>What I built</h2>
      <ul>{c.built.map((b) => <li>{b}</li>)}</ul>
    </section>
    {c.result && <section><h2>Result</h2><p>{c.result}</p></section>}
    {c.architecture && <section><h2>Architecture</h2><p>{c.architecture}</p></section>}
    <section>
      <h2>Tech</h2>
      <ul class="chips">{p.technologies.map((t) => <li>{t}</li>)}</ul>
    </section>
    {c.links.length > 0 && (
      <section>
        <h2>Links</h2>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.url} rel="noopener" target="_blank">{l.label}</a></li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style is:global>
  .cs { overflow-wrap: anywhere; max-width: 46rem; margin: 0 auto; padding: 1.5rem 16px 3rem; font-family: var(--font-serif); line-height: 1.55; }
  .cs a { color: var(--accent-ink); }
  .cs .player {
    display: flex; gap: 1rem; align-items: center; background: #fff9;
    border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--accent); padding: 1rem; margin-bottom: 1.5rem;
  }
  .cs .player svg { display: block; flex: none; }
  .cs h1 { font-family: var(--font-pixel); margin: .4rem 0 .2rem; }
  .cs h2 { font-family: var(--font-pixel); font-size: 1.3rem; margin: 1.5rem 0 .5rem; }
  .cs .role { color: var(--muted); margin: 0; }
  .cs .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .cs .chips li { font: 600 .75rem var(--font-sans); border: 1px solid var(--line); padding: .1rem .45rem; }
  @media (max-width: 480px) { .cs .player { flex-direction: column; align-items: flex-start; } }
</style>
